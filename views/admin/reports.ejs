<%- include('../partials/head') %>
<% const s = report.summary; %>
<div class="dash-title"><div><h2>Reports &amp; analytics</h2><p>Orders placed between <strong><%= from %></strong> and <strong><%= to %></strong> (Bhutan time).</p></div>
  <div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-navy" href="/admin/reports/export.csv?from=<%= from %>&to=<%= to %>"><i class="bi bi-filetype-csv me-1"></i>Download CSV</a>
    <button class="btn btn-navy" type="button" data-print><i class="bi bi-printer me-1"></i>Print</button></div></div>

<form class="filter-bar" method="get" action="/admin/reports" data-no-loading>
  <div class="row g-2 align-items-end">
    <div class="col-6 col-md-3"><label class="form-label small" for="from">From</label><input class="form-control" type="date" id="from" name="from" value="<%= from %>"></div>
    <div class="col-6 col-md-3"><label class="form-label small" for="to">To</label><input class="form-control" type="date" id="to" name="to" value="<%= to %>"></div>
    <div class="col-auto"><button class="btn btn-navy" type="submit"><i class="bi bi-funnel me-1"></i>Generate report</button></div>
  </div>
</form>

<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3"><div class="ph-card stat-tile"><div class="icon-tile"><i class="bi bi-bag"></i></div><div><div class="num"><%= s.orders %></div><div class="lbl">Orders placed</div></div></div></div>
  <div class="col-6 col-xl-3"><div class="ph-card stat-tile amber"><div class="icon-tile"><i class="bi bi-receipt"></i></div><div><div class="num"><%= money(s.order_value) %></div><div class="lbl">Order value</div></div></div></div>
  <div class="col-6 col-xl-3"><div class="ph-card stat-tile good"><div class="icon-tile"><i class="bi bi-cash-coin"></i></div><div><div class="num"><%= money(s.paid) %></div><div class="lbl">Paid</div></div></div></div>
  <div class="col-6 col-xl-3"><div class="ph-card stat-tile warn"><div class="icon-tile"><i class="bi bi-x-circle"></i></div><div><div class="num"><%= s.lost %></div><div class="lbl">Cancelled / rejected</div></div></div></div>
</div>

<div class="ph-card mb-4"><div class="card-title-bar"><h6>Order value per day</h6></div><div class="card-pad"><div class="chart-box" style="height:240px">
  <canvas role="img" aria-label="Order value per day" data-chart='<%= JSON.stringify({ type: "bar", labels: report.byDay.map(function (d) { return d.day; }), values: report.byDay.map(function (d) { return Number(d.value); }), label: "Order value (Nu)", money: true }) %>'></canvas></div></div></div>

<div class="row g-4">
  <div class="col-xl-7"><div class="ph-card">
    <div class="card-title-bar"><h6>Revenue by service</h6></div>
    <% if (!report.byService.length) { %><div class="p-4 text-center text-muted small">No orders in this period.</div><% } else { %>
    <div class="table-responsive"><table class="table ph-table"><thead><tr><th>Service</th><th>Lines</th><th>Pages</th><th class="text-end">Revenue</th></tr></thead><tbody>
      <% report.byService.forEach(function (r) { %><tr><td><%= r.service_name %></td><td><%= r.lines %></td><td><%= r.pages %></td><td class="text-end fw-bold"><%= money(r.revenue) %></td></tr><% }) %>
    </tbody></table></div><% } %>
  </div></div>
  <div class="col-xl-5">
    <div class="ph-card mb-4"><div class="card-title-bar"><h6>Orders by status</h6></div>
      <div class="table-responsive"><table class="table ph-table"><tbody>
        <% report.byStatus.forEach(function (r) { %><tr><td><%- include('../partials/status', { s: r.status }) %></td><td class="text-end fw-bold"><%= r.n %></td></tr><% }) %>
        <% if (!report.byStatus.length) { %><tr><td class="text-muted small text-center">No orders in this period.</td></tr><% } %>
      </tbody></table></div></div>
    <div class="ph-card"><div class="card-title-bar"><h6>Top students</h6></div>
      <div class="table-responsive"><table class="table ph-table"><tbody>
        <% report.topStudents.forEach(function (r) { %><tr><td><strong><%= r.full_name %></strong><div class="small text-muted"><%= r.student_id || '' %> · <%= r.orders %> order<%= r.orders === 1 ? '' : 's' %></div></td><td class="text-end fw-bold"><%= money(r.spent) %></td></tr><% }) %>
        <% if (!report.topStudents.length) { %><tr><td class="text-muted small text-center">No data.</td></tr><% } %>
      </tbody></table></div></div>
  </div>
</div>
<%- include('../partials/foot') %>
