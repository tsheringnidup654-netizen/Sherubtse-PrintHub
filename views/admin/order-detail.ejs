<%- include('../partials/head') %>
<div class="dash-title">
  <div>
    <h2>Order <%= order.order_number %></h2>
    <p>Placed <%= fmtShort(order.created_at) %> by <strong><%= order.full_name %></strong> (<%= order.student_id || order.email %>) · <%- include('../partials/status', { s: order.status }) %>
      <% if (order.is_urgent) { %><span class="tag-urgent"><i class="bi bi-lightning-charge-fill"></i> Urgent <%= order.urgent_status === 'requested' ? 'requested' : order.urgent_status %></span><% } %>
      <% if (order.is_delayed) { %><span class="tag-delay">Delayed</span><% } %></p>
  </div>
  <div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-navy" href="/admin/orders/<%= order.id %>/invoice"><i class="bi bi-file-earmark-pdf me-1"></i>Invoice PDF</a><a class="btn btn-outline-secondary" href="/admin/orders">← All orders</a></div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="mb-4"><%- include('../partials/countdown', { o: order }) %></div>

    <div class="ph-card card-pad mb-4">
      <h6 class="mb-0">Progress</h6>
      <%- include('../partials/tracker', { status: order.status }) %>
    </div>

    <% if (order.urgent_status === 'requested') { %>
    <div class="ph-card card-pad mb-4" style="border-color:#f3c9a8;background:#fffaf5">
      <h6 class="text-danger"><i class="bi bi-lightning-charge-fill me-1"></i>Urgent printing requested</h6>
      <p class="small mb-3">The student asked for priority printing (surcharge <%= money(order.urgent_fee) %>). Approve it only if the workload allows. Declining processes the order normally and removes the surcharge.</p>
      <div class="d-flex gap-2">
        <form method="post" action="/admin/orders/<%= order.id %>/urgent"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="decision" value="approve"><button class="btn btn-navy" type="submit"><i class="bi bi-check2 me-1"></i>Approve urgent</button></form>
        <form method="post" action="/admin/orders/<%= order.id %>/urgent" data-confirm="Decline the urgent request? The surcharge will be removed." data-confirm-btn="Yes, decline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="decision" value="reject"><button class="btn btn-outline-danger" type="submit">Decline</button></form>
      </div>
    </div>
    <% } %>

    <div class="ph-card mb-4">
      <div class="card-title-bar"><h6>Items &amp; documents</h6></div>
      <div class="table-responsive"><table class="table ph-table">
        <thead><tr><th>Service</th><th>Print specification</th><th>File</th><th class="text-end">Amount</th></tr></thead>
        <tbody>
        <% items.forEach(function (it) { %>
          <tr>
            <td><strong><%= it.service_name %></strong></td>
            <td class="small"><%= it.pages %> page<%= it.pages > 1 ? 's' : '' %> × <%= it.copies %> cop<%= it.copies > 1 ? 'ies' : 'y' %><br><span class="text-muted"><%= optionSummary(it) %></span><% if (it.instructions) { %><br><em>“<%= it.instructions %>”</em><% } %></td>
            <td class="small">
              <% if (it.document_id) { %><a href="/admin/documents/<%= it.document_id %>/file" target="_blank" rel="noopener"><i class="bi bi-file-earmark-text me-1"></i><%= it.document_name %></a>
              <% } else if (it.document_name) { %><span class="text-muted"><%= it.document_name %> (deleted)</span>
              <% } else { %><span class="text-muted">Originals brought to shop</span><% } %></td>
            <td class="text-end fw-bold"><%= money(it.line_total) %></td>
          </tr>
        <% }) %>
        </tbody>
        <tfoot>
          <tr><td colspan="3" class="text-end">Subtotal</td><td class="text-end"><%= money(order.subtotal) %></td></tr>
          <% if (Number(order.urgent_fee) > 0) { %><tr><td colspan="3" class="text-end">Urgent surcharge</td><td class="text-end"><%= money(order.urgent_fee) %></td></tr><% } %>
          <tr><td colspan="3" class="text-end fw-bold">Total</td><td class="text-end fw-bold text-navy"><%= money(order.total) %></td></tr>
        </tfoot>
      </table></div>
      <% if (order.notes) { %><div class="card-pad pt-0 small"><strong>Student note:</strong> <%= order.notes %></div><% } %>
    </div>

    <% if (['pending', 'accepted', 'printing', 'ready'].includes(order.status)) { %>
    <div class="ph-card mb-4">
      <div class="card-title-bar"><h6><i class="bi bi-calendar2-week me-1"></i>Schedule &amp; delay notice</h6></div>
      <form class="card-pad" method="post" action="/admin/orders/<%= order.id %>/schedule" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
          <div class="col-md-6">
            <span class="form-label d-block">Estimated completion <small class="text-muted fw-normal">(Bhutan time - shown to the student)</small></span>
            <div class="row g-2"><div class="col-7"><input class="form-control" type="date" name="est_date" value="<%= est.date %>" aria-label="Estimated completion date"></div><div class="col-5"><input class="form-control" type="time" name="est_time" value="<%= est.time %>" aria-label="Estimated completion time"></div></div>
            <% if (order.estimated_completion) { %><div class="form-check mt-1"><input class="form-check-input" type="checkbox" id="clear_estimate" name="clear_estimate"><label class="form-check-label small" for="clear_estimate">Clear the estimate</label></div><% } %>
          </div>
          <div class="col-md-6">
            <span class="form-label d-block">Change collection deadline <small class="text-muted fw-normal">(leave unchanged to keep)</small></span>
            <div class="row g-2"><div class="col-7"><input class="form-control" type="date" name="deadline_date" aria-label="New deadline date"></div><div class="col-5"><input class="form-control" type="time" name="deadline_time" aria-label="New deadline time"></div></div>
            <div class="form-text">Currently: <%= fmtFull(order.collection_deadline) %></div>
          </div>
          <div class="col-12">
            <div class="form-check"><input class="form-check-input" type="checkbox" id="notify_delay" name="notify_delay"><label class="form-check-label fw-semibold" for="notify_delay">Notify the student about a delay</label></div>
            <input class="form-control mt-2" name="delay_note" maxlength="300" placeholder="Reason, e.g. printer maintenance - expected 2 hours late" value="<%= order.delay_note || '' %>" aria-label="Delay reason">
            <% if (order.is_delayed) { %><div class="form-check mt-2"><input class="form-check-input" type="checkbox" id="clear_delay" name="clear_delay"><label class="form-check-label small" for="clear_delay">Clear the delay flag</label></div><% } %>
          </div>
          <div class="col-12"><button class="btn btn-navy" type="submit"><i class="bi bi-send me-1"></i>Save &amp; notify student</button></div>
        </div>
      </form>
    </div>
    <% } %>
  </div>

  <div class="col-lg-4">
    <div class="ph-card card-pad mb-4">
      <h6 class="mb-3">Update status</h6>
      <% if (next && next.length) { %>
        <form method="post" action="/admin/orders/<%= order.id %>/status" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="form-label" for="note">Note <small class="text-muted fw-normal">(required when rejecting)</small></label>
          <input class="form-control mb-3" id="note" name="note" maxlength="300" placeholder="Optional message for the timeline">
          <div class="d-grid gap-2">
            <% next.forEach(function (s) { %>
              <button class="btn <%= s === 'rejected' ? 'btn-outline-danger' : 'btn-navy' %>" type="submit" name="status" value="<%= s %>">
                <%= ({ accepted: 'Accept order', printing: 'Start printing', ready: 'Mark ready for collection', rejected: 'Reject order' })[s] || STATUS_LABELS[s] %></button>
            <% }) %>
          </div>
        </form>
      <% } else if (order.status === 'ready') { %>
        <p class="small text-muted">Hand over the documents with the QR / manual collection page.</p>
        <a class="btn btn-navy w-100" href="/admin/collect/<%= order.qr_token %>"><i class="bi bi-qr-code-scan me-1"></i>Open collection page</a>
      <% } else { %>
        <p class="small text-muted mb-0">This order is <strong><%= STATUS_LABELS[order.status].toLowerCase() %></strong> - no further status changes.</p>
      <% } %>
      <p class="small text-muted mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>The countdown never changes the status. Only you control printing progress.</p>
    </div>

    <div class="ph-card card-pad mb-4">
      <h6 class="mb-3">Customer &amp; payment</h6>
      <div class="small mb-2"><strong><%= order.full_name %></strong><br><%= order.email %></div>
      <div class="summary-row"><span>Method</span><span class="text-capitalize"><%= payment ? payment.method : '—' %></span></div>
      <div class="summary-row"><span>Status</span><span><% if (payment) { %><span class="st st-<%= payment.status %>"><%= payment.status %></span><% } %></span></div>
      <% if (payment && payment.reference) { %><div class="summary-row"><span>Reference</span><span><%= payment.reference %></span></div><% } %>
      <a class="small fw-bold" href="/admin/payments">Manage payments →</a>
    </div>

    <% if (collection) { %>
    <div class="ph-card card-pad mb-4"><h6 class="mb-2"><i class="bi bi-bag-check me-1"></i>Collection record</h6>
      <div class="small">Collected <%= fmtShort(collection.collected_at) %> via <%= collection.verified_via === 'qr' ? 'QR code' : 'manual check' %><% if (collection.handed_by_name) { %><br>Handed over by <%= collection.handed_by_name %><% } %><% if (collection.note) { %><br>Note: <%= collection.note %><% } %></div></div>
    <% } %>

    <div class="ph-card card-pad">
      <h6 class="mb-3">Timeline</h6>
      <ul class="timeline">
        <% history.forEach(function (h) { %>
          <li><strong><%= STATUS_LABELS[h.status] || h.status %></strong><div class="small"><%= h.note || '' %><% if (h.changed_by_name) { %> <span class="text-muted">— <%= h.changed_by_name %></span><% } %></div><div class="when"><%= fmtShort(h.changed_at) %></div></li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
