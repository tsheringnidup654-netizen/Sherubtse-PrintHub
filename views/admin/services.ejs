<%- include('../partials/head') %>
<div class="dash-title"><div><h2>Services &amp; prices</h2><p>Changes apply to new orders and to everything in students' carts straight away.</p></div>
  <button class="btn btn-navy" id="new-service" type="button"><i class="bi bi-plus-circle me-1"></i>Add service</button></div>

<div class="ph-card mb-4">
  <div class="table-responsive"><table class="table ph-table">
    <thead><tr><th>Service</th><th>Category</th><th>Pricing</th><th>Price</th><th>Colour</th><th>Visible</th><th></th></tr></thead>
    <tbody>
    <% services.forEach(function (s) { %>
      <tr>
        <td><div class="d-flex align-items-center gap-2"><div class="icon-tile" style="width:40px;height:40px;font-size:1.1rem"><i class="bi <%= s.icon %>"></i></div><div><strong><%= s.name %></strong><div class="small text-muted"><%= s.options_text %></div></div></div></td>
        <td class="small"><%= s.category_name %></td>
        <td class="small"><%= ({ print: 'Per page (print options)', per_page_flat: 'Per page (flat)', per_set: 'Per document' })[s.pricing_type] %></td>
        <td class="fw-bold"><%= money(s.base_price) %> <small class="text-muted fw-normal"><%= s.unit_label %></small></td>
        <td><%= s.colour_price != null ? money(s.colour_price) : '—' %></td>
        <td><span class="st <%= s.is_active ? 'st-collected' : 'st-cancelled' %>"><%= s.is_active ? 'Visible' : 'Hidden' %></span></td>
        <td class="text-end text-nowrap">
          <button type="button" class="btn btn-sm btn-outline-navy" data-edit-service='<%= JSON.stringify({ id: s.id, name: s.name, description: s.description, icon: s.icon, base_price: s.base_price, colour_price: s.colour_price, unit_label: s.unit_label, options_text: s.options_text, sort_order: s.sort_order, category_id: s.category_id, pricing_type: s.pricing_type }) %>'><i class="bi bi-pencil"></i> Edit</button>
          <form class="d-inline" method="post" action="/admin/services/<%= s.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="active" value="<%= s.is_active ? 'false' : 'true' %>">
            <button class="btn btn-sm btn-outline-secondary" type="submit"><%= s.is_active ? 'Hide' : 'Show' %></button></form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</div>

<div class="ph-card">
  <div class="card-title-bar"><h6>Pricing rules &amp; shop settings</h6></div>
  <form class="card-pad" method="post" action="/admin/services/settings" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row g-3">
      <div class="col-6 col-md-4 col-xl-2"><label class="form-label" for="a3_multiplier">A3 price multiplier</label><input class="form-control" type="number" step="0.01" min="1" max="10" id="a3_multiplier" name="a3_multiplier" value="<%= settings.a3_multiplier %>"></div>
      <div class="col-6 col-md-4 col-xl-2"><label class="form-label" for="hq_multiplier">High-quality multiplier</label><input class="form-control" type="number" step="0.01" min="1" max="5" id="hq_multiplier" name="hq_multiplier" value="<%= settings.hq_multiplier %>"></div>
      <div class="col-6 col-md-4 col-xl-2"><label class="form-label" for="duplex_discount">Double-sided discount %</label><input class="form-control" type="number" step="1" min="0" max="90" id="duplex_discount" name="duplex_discount" value="<%= settings.duplex_discount %>"></div>
      <div class="col-6 col-md-4 col-xl-2"><label class="form-label" for="urgent_surcharge_pct">Urgent surcharge %</label><input class="form-control" type="number" step="1" min="0" max="300" id="urgent_surcharge_pct" name="urgent_surcharge_pct" value="<%= settings.urgent_surcharge_pct %>"></div>
      <div class="col-6 col-md-4 col-xl-2"><label class="form-label" for="pages_per_hour">Pages per hour (capacity)</label><input class="form-control" type="number" min="10" max="10000" id="pages_per_hour" name="pages_per_hour" value="<%= settings.pages_per_hour %>"></div>
      <div class="col-6 col-md-4 col-xl-2"><label class="form-label" for="min_lead_minutes">Minimum lead time (min)</label><input class="form-control" type="number" min="0" max="1440" id="min_lead_minutes" name="min_lead_minutes" value="<%= settings.min_lead_minutes %>"></div>
      <div class="col-md-6"><label class="form-label" for="shop_location">Shop location</label><input class="form-control" id="shop_location" name="shop_location" value="<%= settings.shop_location %>"></div>
      <div class="col-md-6"><label class="form-label" for="shop_hours">Opening hours</label><input class="form-control" id="shop_hours" name="shop_hours" value="<%= settings.shop_hours %>"></div>
      <div class="col-md-6"><label class="form-label" for="shop_phone">Phone</label><input class="form-control" id="shop_phone" name="shop_phone" value="<%= settings.shop_phone %>"></div>
      <div class="col-md-6"><label class="form-label" for="shop_email">E-mail</label><input class="form-control" id="shop_email" name="shop_email" value="<%= settings.shop_email %>"></div>
      <div class="col-12"><button class="btn btn-navy" type="submit"><i class="bi bi-save me-1"></i>Save settings</button></div>
    </div>
  </form>
</div>

<div class="modal fade" id="service-modal" tabindex="-1" aria-hidden="true" aria-labelledby="service-modal-title">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <form class="modal-content rounded-4" id="service-form" method="post" action="/admin/services" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header"><h5 class="modal-title" id="service-modal-title">Add new service</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body"><div class="row g-3">
        <div class="col-md-8"><label class="form-label" for="sv-name">Name</label><input class="form-control" id="sv-name" name="name" required maxlength="100"></div>
        <div class="col-md-4"><label class="form-label" for="sv-cat">Category</label><select class="form-select" id="sv-cat" name="category_id"><% categories.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
        <div class="col-12"><label class="form-label" for="sv-desc">Description</label><textarea class="form-control" id="sv-desc" name="description" rows="2" required maxlength="600"></textarea></div>
        <div class="col-md-4"><label class="form-label" for="sv-type">Pricing type</label>
          <select class="form-select" id="sv-type" name="pricing_type"><option value="print">Per page + print options</option><option value="per_page_flat">Per page (flat)</option><option value="per_set">Per document</option></select></div>
        <div class="col-6 col-md-4"><label class="form-label" for="sv-price">Price (Nu)</label><input class="form-control" type="number" step="0.01" min="0" id="sv-price" name="base_price" required></div>
        <div class="col-6 col-md-4"><label class="form-label" for="sv-colour">Colour price (Nu)</label><input class="form-control" type="number" step="0.01" min="0" id="sv-colour" name="colour_price" placeholder="blank = no colour"></div>
        <div class="col-6 col-md-3"><label class="form-label" for="sv-unit">Unit label</label><input class="form-control" id="sv-unit" name="unit_label" maxlength="30"></div>
        <div class="col-6 col-md-3"><label class="form-label" for="sv-icon">Icon (Bootstrap)</label><input class="form-control" id="sv-icon" name="icon" placeholder="bi-printer"></div>
        <div class="col-6 col-md-3"><label class="form-label" for="sv-sort">Sort order</label><input class="form-control" type="number" id="sv-sort" name="sort_order"></div>
        <div class="col-12"><label class="form-label" for="sv-opts">Options text</label><input class="form-control" id="sv-opts" name="options_text" maxlength="255"></div>
      </div></div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-navy" type="submit">Save service</button></div>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
