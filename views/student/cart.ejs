<%- include('../partials/head') %>
<div class="dash-title"><div><h2>Shopping cart</h2><p>Review your items, then continue to checkout.</p></div>
  <a href="/student/customize" class="btn btn-outline-navy"><i class="bi bi-plus-circle me-1"></i>Add another item</a></div>

<% if (!lines.length) { %>
  <div class="ph-card"><%- include('../partials/empty', { icon: 'bi-cart-x', heading: 'Your cart is empty', text: 'Add a printing service to get started.', href: '/services', cta: 'Browse services' }) %></div>
<% } else { %>
<div class="row g-4">
  <div class="col-lg-8">
    <div class="ph-card">
      <% lines.forEach(function (l) { %>
        <div class="cart-line">
          <div class="icon-tile"><i class="bi <%= l.icon %>"></i></div>
          <div class="flex-grow-1 min-w-0">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
              <strong><%= l.service_name %></strong>
              <strong class="text-navy"><%= money(l.line_total) %></strong>
            </div>
            <div class="small text-muted"><%= l.pages %> page<%= l.pages > 1 ? 's' : '' %> × <%= l.copies %> cop<%= l.copies > 1 ? 'ies' : 'y' %><% if (l.pricing_type !== 'per_set') { %> · <%= optionSummary(l) %><% } %></div>
            <% if (l.document_name) { %><div class="small"><i class="bi bi-file-earmark-text me-1"></i><%= l.document_name %></div><% } else { %><div class="small text-muted"><i class="bi bi-hand-index me-1"></i>Originals will be brought to the shop</div><% } %>
            <% if (l.instructions) { %><div class="small text-muted"><i class="bi bi-chat-left-text me-1"></i><%= l.instructions %></div><% } %>
            <% if (!l.service_active) { %><div class="small text-danger fw-bold">This service is no longer available - please remove it.</div><% } %>
          </div>
          <div class="d-flex flex-column gap-1">
            <a class="btn btn-sm btn-outline-navy" href="/student/customize?edit=<%= l.id %>"><i class="bi bi-pencil"></i> Edit</a>
            <form method="post" action="/student/cart/<%= l.id %>/remove" data-confirm="Remove this item from your cart?" data-confirm-btn="Yes, remove">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-outline-danger w-100" type="submit"><i class="bi bi-trash"></i> Remove</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="ph-card card-pad">
      <h6 class="mb-3">Order summary</h6>
      <div class="summary-row"><span>Items</span><span><%= lines.length %></span></div>
      <div class="summary-row"><span>Subtotal</span><span><%= money(subtotal) %></span></div>
      <div class="summary-row total"><span>Total</span><span><%= money(subtotal) %></span></div>
      <p class="small text-muted mt-2 mb-3">Urgent printing and your payment method are chosen at checkout.</p>
      <a href="/student/checkout" class="btn btn-navy w-100"><i class="bi bi-bag-check me-1"></i>Proceed to checkout</a>
    </div>
  </div>
</div>
<% } %>
<%- include('../partials/foot') %>
