<% const isDash = typeof locals.section !== 'undefined'; const p = currentPath; %>
<nav class="navbar navbar-expand-lg ph-navbar">
  <div class="container-xl">
    <% if (isDash) { %>
      <button class="btn btn-sm btn-outline-navy d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu"><i class="bi bi-list fs-5"></i></button>
    <% } %>
    <a class="navbar-brand" href="/">
      <img src="/img/logo.png" alt="Sherubtse College crest" class="brand-logo">
      <span class="d-none d-sm-block"><span class="d-block lh-1"><%= APP_NAME %></span><span class="brand-sub">Sherubtse College</span></span>
    </a>
    <button class="navbar-toggler border-0 ms-auto me-2 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#topnav" aria-label="Toggle navigation"><i class="bi bi-three-dots-vertical fs-4"></i></button>
    <div class="collapse navbar-collapse" id="topnav">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item"><a class="nav-link <%= p === '/' ? 'active' : '' %>" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link <%= p === '/services' ? 'active' : '' %>" href="/services">Services</a></li>
        <li class="nav-item"><a class="nav-link <%= p === '/about' ? 'active' : '' %>" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link <%= p === '/contact' ? 'active' : '' %>" href="/contact">Contact</a></li>
      </ul>
      <div class="d-flex align-items-center gap-2 py-2 py-lg-0">
        <% if (user) { %>
          <% if (user.role === 'student') { %>
            <a class="nav-icon" href="/student/cart" title="Shopping cart" aria-label="Shopping cart"><i class="bi bi-cart3"></i><% if (cartCount) { %><span class="badge-dot"><%= cartCount %></span><% } %></a>
          <% } %>
          <a class="nav-icon" href="<%= user.role === 'admin' ? '/admin/notifications' : '/student/notifications' %>" title="Notifications" aria-label="Notifications"><i class="bi bi-bell"></i><span class="badge-dot" id="bell-count" <%- unreadCount ? '' : 'hidden' %>><%= unreadCount %></span></a>
          <div class="dropdown">
            <button class="btn p-0 border-0 d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
              <% if (user.avatar) { %><img class="avatar" src="/avatars/<%= user.avatar %>" alt=""><% } else { %><span class="avatar"><%= user.full_name.trim().charAt(0).toUpperCase() %></span><% } %>
              <span class="d-none d-xl-block small fw-bold text-navy text-start lh-sm"><%= user.full_name.split(' ')[0] %><small class="d-block text-muted fw-normal text-capitalize"><%= user.role %></small></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2">
              <li><a class="dropdown-item rounded-3" href="<%= user.role === 'admin' ? '/admin/dashboard' : '/student/dashboard' %>"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
              <% if (user.role === 'student') { %><li><a class="dropdown-item rounded-3" href="/student/profile"><i class="bi bi-person me-2"></i>My profile</a></li><% } %>
              <li><hr class="dropdown-divider"></li>
              <li><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="dropdown-item rounded-3 text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Log out</button></form></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/login" class="btn btn-outline-navy btn-sm">Log in</a>
          <a href="/register" class="btn btn-navy btn-sm">Register</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
