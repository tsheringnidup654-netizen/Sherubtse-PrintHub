<% const isDash = typeof locals.section !== 'undefined'; %>
<% if (isDash) { %>
  </main>
</div>
<% } else { %>
</main>
<footer class="ph-footer pt-5">
  <div class="container">
    <div class="row g-4 pb-4">
      <div class="col-lg-4">
        <div class="d-flex align-items-center gap-3 mb-3"><img src="/img/logo.png" alt="Sherubtse College" class="foot-logo"><h5 class="text-white m-0"><%= APP_NAME %></h5></div>
        <p class="mb-2"><%= TAGLINE %></p>
        <p class="small mb-0">The official online printing and photocopy store for Sherubtse College, Kanglung, Bhutan.</p>
      </div>
      <div class="col-6 col-lg-2"><h6>Explore</h6>
        <ul class="list-unstyled small lh-lg"><li><a href="/">Home</a></li><li><a href="/services">Printing services</a></li><li><a href="/about">About us</a></li><li><a href="/contact">Contact us</a></li></ul></div>
      <div class="col-6 col-lg-2"><h6>Account</h6>
        <ul class="list-unstyled small lh-lg">
          <% if (user) { %><li><a href="<%= user.role === 'admin' ? '/admin/dashboard' : '/student/dashboard' %>">Dashboard</a></li>
          <% } else { %><li><a href="/login">Login</a></li><li><a href="/register">Register</a></li><% } %></ul></div>
      <div class="col-lg-4"><h6>Visit us</h6>
        <p class="small mb-1"><i class="bi bi-geo-alt me-2"></i>Sherubtse College, Kanglung, Trashigang</p>
        <p class="small mb-1"><i class="bi bi-clock me-2"></i>Mon - Sat, 9:00 AM - 5:00 PM (Bhutan time)</p>
        <p class="small mb-0"><i class="bi bi-envelope me-2"></i>printhub@sherubtse.edu.bt</p></div>
    </div>
    <div class="copy py-3 text-center">&copy; <%= new Date().getFullYear() %> Sherubtse PrintHub &middot; Sherubtse College, Royal University of Bhutan</div>
  </div>
</footer>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.12.4/dist/sweetalert2.all.min.js"></script>
<% if (pageJs.includes('charts')) { %><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script><% } %>
<script src="/js/main.js"></script>
<script src="/js/countdown.js"></script>
<% pageJs.filter(function (j) { return j !== 'charts'; }).forEach(function (j) { %><script src="/js/<%= j %>.js"></script>
<% }) %>
<% if (pageJs.includes('charts')) { %><script src="/js/charts.js"></script><% } %>
</body>
</html>
